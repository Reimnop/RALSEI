<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>14</LangVersion>
    <RootNamespace>Ralsei.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ico.Reader" Version="1.0.3" />
    <PackageReference Include="ManagedBass" Version="3.1.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="OpenTK.Windowing.GraphicsLibraryFramework" Version="5.0.0-pre.11" />
    <PackageReference Include="Ralsei.Redist" Version="1.0.0" />
    <PackageReference Include="ReFuel.StbImage" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Ralsei/Ralsei.csproj" />
    <ProjectReference Include="../Ralsei.Resources.Compressed/Ralsei.Resources.Compressed.csproj" />
    <ProjectReference Include="../Ralsei.Rendering.OpenGL/Ralsei.Rendering.OpenGL.csproj" />
    <ProjectReference Include="../Ralsei.Rendering.OpenGLES/Ralsei.Rendering.OpenGLES.csproj" />
    <ProjectReference Include="../Ralsei.Rendering.Vulkan/Ralsei.Rendering.Vulkan.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="icon.ico" />
  </ItemGroup>
</Project>
