<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK.Graphics" Version="5.0.0-pre.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Ralsei/Ralsei.csproj" />
    <ProjectReference Include="../Ralsei.Rendering.Common/Ralsei.Rendering.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only the compiled SPIR-V is embedded; the GLSL sources are shared with the other backends, in
         Ralsei.Rendering.Common/Resources/Shaders (see compile-shaders.ps1) -->
    <EmbeddedResource Include="Resources/**/*.spv" />
  </ItemGroup>

</Project>
