<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:svc="clr-namespace:Ralsei.Avalonia.Services"
             xmlns:vm="clr-namespace:Ralsei.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
             x:Class="Ralsei.Avalonia.Views.LogsView"
             x:DataType="vm:LogsViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.LogLevel">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="TextBlock.LogLevel.Warning">
            <Setter Property="Foreground" Value="#F59E0B" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBlock.LogLevel.Error">
            <Setter Property="Foreground" Value="#EF4444" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*"
          RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
              ColumnSpacing="8">
            <StackPanel Orientation="Horizontal"
                        Spacing="14"
                        VerticalAlignment="Center">
                <CheckBox Classes="ToggleSwitch"
                          IsChecked="{Binding ProblemsOnly}"
                          Content="Only warnings and errors" />
                <TextBlock Classes="Muted"
                           VerticalAlignment="Center"
                           Text="{Binding EntryCount, StringFormat='{}{0} entries'}" />
                <TextBlock Foreground="#EF4444"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           IsVisible="{Binding ProblemCount}"
                           Text="{Binding ProblemCount, StringFormat='{}{0} problems'}" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="Outline Small"
                    Command="{Binding CopyCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <LucideIcon Kind="Copy" Size="14" />
                    <TextBlock Text="Copy" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2"
                    Classes="Outline Small"
                    Command="{Binding OpenFolderCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <LucideIcon Kind="FolderOpen" Size="14" />
                    <TextBlock Text="Open folder" />
                </StackPanel>
            </Button>
            <Button Grid.Column="3"
                    Classes="Outline Small"
                    Command="{Binding ClearCommand}">
                <StackPanel Orientation="Horizontal"
                            Spacing="6">
                    <LucideIcon Kind="Trash2" Size="14" />
                    <TextBlock Text="Clear" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="{DynamicResource MdCornerRadius}"
                Background="#0D808080"
                ClipToBounds="True">
            <ScrollViewer x:Name="LogScroll"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding VisibleEntries}"
                              Margin="10,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="svc:LogEntry">
                            <Grid ColumnDefinitions="Auto,48,Auto,*"
                                  ColumnSpacing="10"
                                  Margin="0,2">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding TimeText}"
                                           Classes="Muted"
                                           FontFamily="{StaticResource JetbrainsFont}"
                                           FontSize="11" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding LevelText}"
                                           Classes="LogLevel"
                                           Classes.Warning="{Binding IsWarning}"
                                           Classes.Error="{Binding IsError}"
                                           FontFamily="{StaticResource JetbrainsFont}"
                                           FontSize="11" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Category}"
                                           Classes="Muted"
                                           FontFamily="{StaticResource JetbrainsFont}"
                                           FontSize="11" />
                                <SelectableTextBlock Grid.Column="3"
                                                     Text="{Binding Message}"
                                                     TextWrapping="Wrap"
                                                     FontFamily="{StaticResource JetbrainsFont}"
                                                     FontSize="11" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
