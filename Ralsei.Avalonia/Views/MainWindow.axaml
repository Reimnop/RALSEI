<shadui:Window xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:Ralsei.Avalonia.ViewModels"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
               SaveWindowState="True"
               TitleFontWeight="SemiBold"
               Width="1100"
               Height="700"
               MinWidth="640"
               MinHeight="420"
               WindowStartupLocation="CenterScreen"
               EnableTrafficLightPositioning="True"
               TrafficLightOffset="5,8"
               mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
               x:Class="Ralsei.Avalonia.Views.MainWindow"
               x:DataType="vm:MainWindowViewModel"
               Icon="/Assets/icon.ico"
               IsTitleBarVisible="{Binding !IsFullScreen}"
               Title="{Binding WindowTitle}">
    <shadui:Window.Styles>
        <!-- Dialogs come and go with a fade -->
        <Style Selector="ContentControl.Overlay">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.2"
                                      Easing="{StaticResource EaseOut}" />
                    <TransformOperationsTransition Property="RenderTransform"
                                                   Duration="0:0:0.2"
                                                   Easing="{StaticResource EaseOut}" />
                </Transitions>
            </Setter>
            <Style Selector="^[IsHitTestVisible=True]">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="RenderTransform" Value="scale(1) translateY(0)" />
            </Style>
            <Style Selector="^[IsHitTestVisible=False]">
                <Setter Property="Opacity" Value="0" />
                <Setter Property="RenderTransform" Value="scale(0.96) translateY(12px)" />
            </Style>
        </Style>
    </shadui:Window.Styles>

    <shadui:Window.Hosts>

        <!-- Messages -->
        <shadui:ToastHost Manager="{Binding ToastManager}" />

        <!-- A level is being dragged over the window -->
        <Border x:Name="DropOverlay"
                IsVisible="False"
                IsHitTestVisible="False"
                Background="#B3000000"
                Margin="12"
                CornerRadius="{DynamicResource XlCornerRadius}"
                BorderBrush="{DynamicResource PrimaryColor}"
                BorderThickness="2">
            <ThemeVariantScope RequestedThemeVariant="Dark">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <LucideIcon Kind="FolderOpen"
                                Size="48"
                                HorizontalAlignment="Center" />
                    <TextBlock Text="Drop to open the level"
                               Classes="h3"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </ThemeVariantScope>
        </Border>

        <!-- Export overlay -->
        <ContentControl Classes="Overlay"
                        Content="{Binding ExportViewModel}"
                        IsHitTestVisible="{Binding IsExportOpen}" />

        <!-- Settings overlay -->
        <ContentControl Classes="Overlay"
                        Content="{Binding SettingsViewModel}"
                        IsHitTestVisible="{Binding IsSettingsOpen}" />

    </shadui:Window.Hosts>

    <shadui:Window.RightWindowTitleBarContent>
        <StackPanel Orientation="Horizontal"
                    FlowDirection="RightToLeft"
                    Spacing="8">
            <Button Background="{DynamicResource SidebarBackgroundColor}"
                    CornerRadius="{DynamicResource MdCornerRadius}"
                    Width="30"
                    Height="30"
                    ToolTip.Tip="Settings (Ctrl+,)"
                    Content="{LucideIconContent Settings, Size=20}"
                    Command="{Binding OpenSettingsCommand}"
                    VerticalAlignment="Center" />
            <Button Background="{DynamicResource SidebarBackgroundColor}"
                    CornerRadius="{DynamicResource MdCornerRadius}"
                    Height="30"
                    Width="30"
                    ToolTip.Tip="Open a level"
                    Content="{LucideIconContent FolderOpen, Size=20}"
                    VerticalAlignment="Center">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="Open a folder"
                                  InputGesture="Ctrl+O"
                                  Command="{Binding PlaybackViewModel.OpenFolderCommand}" />
                        <MenuItem Header="Open files"
                                  InputGesture="Ctrl+Shift+O"
                                  Command="{Binding PlaybackViewModel.OpenFilesCommand}" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
            <Button Background="{DynamicResource SidebarBackgroundColor}"
                    CornerRadius="{DynamicResource MdCornerRadius}"
                    Height="30"
                    Width="30"
                    ToolTip.Tip="Export a video (Ctrl+E)"
                    IsEnabled="{Binding CanOpenExport}"
                    Command="{Binding OpenExportCommand}"
                    Content="{LucideIconContent Film, Size=20}"
                    VerticalAlignment="Center" />
            <TextBlock FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       FlowDirection="LeftToRight"
                       IsVisible="{Binding ExportViewModel.IsRunning}"
                       Text="{Binding ExportViewModel.BadgeText}" />
            <TextBlock FontWeight="Bold"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       HorizontalAlignment="Right"
                       FlowDirection="LeftToRight"
                       IsVisible="{Binding SettingsViewModel.ShowStats}"
                       Text="{Binding PlaybackViewModel.Fps, StringFormat='{}{0} FPS'}" />
        </StackPanel>
    </shadui:Window.RightWindowTitleBarContent>

    <ContentControl Content="{Binding PlaybackViewModel}" />
</shadui:Window>
