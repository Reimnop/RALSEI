<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ralsei.Avalonia.ViewModels"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:conv="clr-namespace:Ralsei.Avalonia.Converters"
             xmlns:controls="clr-namespace:Ralsei.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Ralsei.Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Focusable="True">
    <UserControl.Styles>
        <!-- A key of a shortcut -->
        <Style Selector="Border.Key">
            <Setter Property="Background" Value="#1A808080" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.Key > TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource JetbrainsFont}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="ComboBox.Setting">
            <Setter Property="Width" Value="200" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <Border Background="{DynamicResource DialogOverlayColor}"
                Opacity="0.6" />
        <Border Background="{DynamicResource DialogBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="{DynamicResource XlCornerRadius}"
                Margin="24"
                MaxWidth="860"
                MaxHeight="640"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid RowDefinitions="Auto,*"
                  Margin="24"
                  RowSpacing="18">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Classes="h4"
                               Text="Settings" />
                    <Button Grid.Column="1"
                            Classes="Icon"
                            Command="{Binding CloseCommand}"
                            Width="30"
                            Height="30"
                            Content="{LucideIconContent X, Size=20}" />
                </Grid>

                <TabControl Grid.Row="1"
                            SelectedIndex="{Binding SelectedTabIndex}">
                    <!-- General -->
                    <TabItem Header="General">
                        <ScrollViewer Padding="0,0,14,0">
                            <StackPanel Spacing="18"
                                        Margin="0,10,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <controls:SettingsLabel Content="Theme"
                                                            Description="The colors of the app. The player stays dark, whatever the level looks like." />
                                    <ComboBox Grid.Column="1"
                                              Classes="Setting"
                                              ItemsSource="{x:Static vm:SettingsViewModel.ThemeNames}"
                                              SelectedIndex="{Binding ThemeIndex}" />
                                </Grid>
                                <CheckBox Classes="ToggleSwitch"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{Binding EnablePostProcessing}">
                                    <controls:SettingsLabel Content="Post-processing"
                                                            Description="Bloom, chromatic aberration, glitch and the other effects of a level. Turn it off on a computer that can not keep up." />
                                </CheckBox>
                                <CheckBox Classes="ToggleSwitch"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{Binding EnableTextRendering}">
                                    <controls:SettingsLabel Content="Text"
                                                            Description="Draws the text objects of a level. This is not perfect and may cause visual artifacts." />
                                </CheckBox>
                                <CheckBox Classes="ToggleSwitch"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{Binding LockAspectRatio}">
                                    <controls:SettingsLabel Content="Lock the aspect ratio to 16:9"
                                                            Description="Levels are made for 16:9. Unlocked, a level fills the window, which shows more or less of it." />
                                </CheckBox>
                                <Grid ColumnDefinitions="*,Auto">
                                    <controls:SettingsLabel Content="Resolution"
                                                            Description="How much of the window is rendered. A level at 50% takes a quarter of the work, and is stretched to fill the window." />
                                    <ComboBox Grid.Column="1"
                                              Classes="Setting"
                                              ItemsSource="{x:Static vm:SettingsViewModel.RenderScaleNames}"
                                              SelectedIndex="{Binding RenderScaleIndex}" />
                                </Grid>
                                <CheckBox Classes="ToggleSwitch"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{Binding ShowStats}">
                                    <controls:SettingsLabel Content="Performance stats"
                                                            Description="Shows the frame rate and how long a frame takes over the level." />
                                </CheckBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Playback -->
                    <TabItem Header="Playback">
                        <ScrollViewer Padding="0,0,14,0">
                            <StackPanel Spacing="18"
                                        Margin="0,10,0,0">
                                <CheckBox Classes="ToggleSwitch"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{Binding AutoPlay}">
                                    <controls:SettingsLabel Content="Play when a level is opened"
                                                            Description="Starts the song as soon as the level is ready." />
                                </CheckBox>
                                <CheckBox Classes="ToggleSwitch"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{Binding Loop}">
                                    <controls:SettingsLabel Content="Loop the song"
                                                            Description="Starts over when the song ends." />
                                </CheckBox>
                                <Grid ColumnDefinitions="*,Auto">
                                    <controls:SettingsLabel Content="Speed"
                                                            Description="How fast the song plays. The pitch of the song follows." />
                                    <ComboBox Grid.Column="1"
                                              Classes="Setting"
                                              ItemsSource="{x:Static vm:SettingsViewModel.PlaybackSpeedNames}"
                                              SelectedIndex="{Binding PlaybackSpeedIndex}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,200,60"
                                      ColumnSpacing="12">
                                    <controls:SettingsLabel Content="Volume" />
                                    <Slider Grid.Column="1"
                                            Minimum="0"
                                            Maximum="1"
                                            VerticalAlignment="Center"
                                            Value="{Binding Volume}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding VolumeText}"
                                               Classes="Muted"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right" />
                                </Grid>
                                <CheckBox Classes="ToggleSwitch"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{Binding RandomSeed}">
                                    <controls:SettingsLabel Content="Random seed"
                                                            Description="Levels use random numbers (for particles, for one). A random seed makes every play different, a fixed one makes it the same every time." />
                                </CheckBox>
                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="8"
                                      IsEnabled="{Binding IsSeedEditable}">
                                    <controls:SettingsLabel Content="Seed" />
                                    <TextBox Grid.Column="1"
                                             Width="200"
                                             Text="{Binding SeedText}" />
                                    <Button Grid.Column="2"
                                            Classes="Outline"
                                            Command="{Binding RandomizeSeedCommand}"
                                            ToolTip.Tip="Pick another seed">
                                        <LucideIcon Kind="Dices" Size="16" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Export -->
                    <TabItem Header="Export">
                        <ScrollViewer Padding="0,0,14,0">
                            <StackPanel Spacing="18"
                                        Margin="0,10,0,0">
                                <StackPanel Spacing="6">
                                    <controls:SettingsLabel Content="FFmpeg"
                                                            Description="Videos are made with FFmpeg. Leave this empty to use the one that is installed on the system." />
                                    <Grid ColumnDefinitions="*,Auto,Auto"
                                          ColumnSpacing="8">
                                        <TextBox Text="{Binding FFmpegPath}"
                                                 PlaceholderText="ffmpeg" />
                                        <Button Grid.Column="1"
                                                Classes="Outline"
                                                Command="{Binding BrowseFFmpegCommand}"
                                                Content="Browse..." />
                                        <Button Grid.Column="2"
                                                Classes="Outline"
                                                Command="{Binding CheckFFmpegCommand}"
                                                ToolTip.Tip="Look for it again"
                                                Content="{LucideIconContent RotateCw, Size=16}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="8">
                                        <LucideIcon Size="16"
                                                    VerticalAlignment="Center"
                                                    Kind="{Binding IsFFmpegFound, Converter={x:Static conv:Converters.FoundIcon}}" />
                                        <StackPanel Grid.Column="1"
                                                    Spacing="2">
                                            <TextBlock FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding FFmpegStatus}" />
                                            <TextBlock Classes="Muted"
                                                       FontSize="11"
                                                       TextTrimming="PrefixCharacterEllipsis"
                                                       IsVisible="{Binding IsFFmpegFound}"
                                                       ToolTip.Tip="{Binding FFmpegLocation}"
                                                       Text="{Binding FFmpegLocation}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <controls:SettingsLabel Content="Size of the video" />
                                    <ComboBox Grid.Column="1"
                                              Classes="Setting"
                                              ItemsSource="{x:Static vm:SettingsViewModel.ExportSizeNames}"
                                              SelectedIndex="{Binding ExportSizeIndex}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <controls:SettingsLabel Content="Frames per second" />
                                    <ComboBox Grid.Column="1"
                                              Classes="Setting"
                                              ItemsSource="{x:Static vm:SettingsViewModel.ExportFramerateNames}"
                                              SelectedIndex="{Binding ExportFramerateIndex}" />
                                </Grid>
                                <StackPanel Spacing="6">
                                    <controls:SettingsLabel Content="Encoding"
                                                            Description="What FFmpeg is told about the video and the sound that go in the file." />
                                    <TextBox Text="{Binding ExportArguments}"
                                             FontFamily="{StaticResource JetbrainsFont}"
                                             FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Logs -->
                    <TabItem Header="Logs">
                        <ContentControl Margin="0,10,0,0"
                                        Content="{Binding Logs}" />
                    </TabItem>

                    <!-- Shortcuts -->
                    <TabItem Header="Shortcuts">
                        <ScrollViewer Padding="0,0,14,0">
                            <ItemsControl ItemsSource="{Binding ShortcutGroups}"
                                          Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ShortcutGroup">
                                        <StackPanel Spacing="8"
                                                    Margin="0,0,0,20">
                                            <TextBlock Text="{Binding Title}"
                                                       Classes="h4" />
                                            <ItemsControl ItemsSource="{Binding Shortcuts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ShortcutInfo">
                                                        <Grid ColumnDefinitions="200,*"
                                                              Margin="0,3">
                                                            <ItemsControl ItemsSource="{Binding KeyList}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    Spacing="6" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="x:String">
                                                                        <Border Classes="Key">
                                                                            <TextBlock Text="{Binding}" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Description}"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <!-- About -->
                    <TabItem Header="About">
                        <StackPanel Spacing="14"
                                    Margin="0,10,0,0">
                            <StackPanel Spacing="2">
                                <TextBlock Text="RALSEI"
                                           Classes="h4" />
                                <TextBlock Text="{Binding VersionText}"
                                           Classes="Muted" />
                            </StackPanel>
                            <TextBlock Classes="p"
                                       TextWrapping="Wrap">
                                Copyright © 2026 Reimnop.
                                <LineBreak />
                                RALSEI is open-source software licensed under the MIT License.
                            </TextBlock>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <Button Classes="Outline"
                                        Command="{Binding Logs.OpenFolderCommand}">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <LucideIcon Kind="FolderOpen" Size="16" />
                                        <TextBlock Text="Open the settings folder" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="Destructive"
                                        Command="{Binding ResetToDefaultsCommand}">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">
                                        <LucideIcon Kind="RotateCcw" Size="16" />
                                        <TextBlock Text="Reset all settings" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Panel>
</UserControl>
