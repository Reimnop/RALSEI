<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

  <ScrollView
      android:id="@+id/scroll"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:clipToPadding="false"
      android:fillViewport="true">

    <LinearLayout
        android:id="@+id/content"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

      <!-- Header -->
      <com.google.android.material.textview.MaterialTextView
          style="@style/TextAppearance.Material3.HeadlineMedium"
          android:text="@string/app_name"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />

      <com.google.android.material.textview.MaterialTextView
          style="@style/TextAppearance.Material3.BodyMedium"
          android:text="@string/tagline"
          android:textColor="?attr/colorOnSurfaceVariant"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="16dp" />

      <!-- Level -->
      <com.google.android.material.card.MaterialCardView
          style="@style/Widget.Material3.CardView.Filled"
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

          <com.google.android.material.textview.MaterialTextView
              style="@style/SectionTitle"
              android:text="@string/section_level"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="12dp" />

          <LinearLayout
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_width="match_parent"
              android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/cover"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:scaleType="centerCrop"
                android:padding="28dp"
                android:src="@drawable/ic_music_note"
                android:background="?attr/colorSecondaryContainer"
                android:contentDescription="@null"
                app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Medium" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="16dp">

              <com.google.android.material.textview.MaterialTextView
                  android:id="@+id/level_title"
                  style="@style/TextAppearance.Material3.TitleMedium"
                  android:text="@string/no_level_title"
                  android:maxLines="2"
                  android:ellipsize="end"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content" />

              <com.google.android.material.textview.MaterialTextView
                  android:id="@+id/level_subtitle"
                  style="@style/TextAppearance.Material3.BodyMedium"
                  android:text="@string/no_level_hint"
                  android:textColor="?attr/colorOnSurfaceVariant"
                  android:maxLines="3"
                  android:ellipsize="end"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content" />

              <com.google.android.material.textview.MaterialTextView
                  android:id="@+id/level_details"
                  style="@style/TextAppearance.Material3.LabelMedium"
                  android:textColor="?attr/colorOnSurfaceVariant"
                  android:visibility="gone"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="4dp" />
            </LinearLayout>
          </LinearLayout>

          <LinearLayout
              android:orientation="horizontal"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_folder"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:text="@string/open_folder"
                app:icon="@drawable/ic_folder_open"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/choose_files"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:text="@string/choose_files"
                app:icon="@drawable/ic_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp" />
          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Recent -->
      <com.google.android.material.textview.MaterialTextView
          style="@style/SectionTitle"
          android:text="@string/section_recent"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="24dp"
          android:layout_marginBottom="4dp"
          android:layout_marginLeft="4dp" />

      <LinearLayout
          android:id="@+id/recent_container"
          android:orientation="vertical"
          android:layout_width="match_parent"
          android:layout_height="wrap_content" />

      <com.google.android.material.textview.MaterialTextView
          android:id="@+id/recent_empty"
          style="@style/TextAppearance.Material3.BodyMedium"
          android:text="@string/recent_empty"
          android:textColor="?attr/colorOnSurfaceVariant"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginLeft="4dp" />

      <!-- Renderer -->
      <com.google.android.material.card.MaterialCardView
          style="@style/Widget.Material3.CardView.Filled"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="24dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

          <com.google.android.material.textview.MaterialTextView
              style="@style/SectionTitle"
              android:text="@string/section_renderer"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="12dp" />

          <com.google.android.material.button.MaterialButtonToggleGroup
              android:id="@+id/backend_toggle"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              app:singleSelection="true"
              app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backend_gles"
                style="?attr/materialButtonOutlinedStyle"
                android:text="@string/backend_gles"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backend_vulkan"
                style="?attr/materialButtonOutlinedStyle"
                android:text="@string/backend_vulkan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
          </com.google.android.material.button.MaterialButtonToggleGroup>

          <com.google.android.material.textview.MaterialTextView
              android:id="@+id/backend_status"
              style="@style/TextAppearance.Material3.BodySmall"
              android:textColor="?attr/colorOnSurfaceVariant"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Display -->
      <com.google.android.material.card.MaterialCardView
          style="@style/Widget.Material3.CardView.Filled"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

          <com.google.android.material.textview.MaterialTextView
              style="@style/SectionTitle"
              android:text="@string/section_display"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="4dp" />

          <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/switch_lock_aspect"
              android:text="@string/lock_aspect_ratio"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:minHeight="48dp" />

          <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/switch_vsync"
              android:text="@string/vsync"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:minHeight="48dp" />

          <com.google.android.material.textview.MaterialTextView
              style="@style/SettingLabel"
              android:text="@string/render_scale"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="12dp"
              android:layout_marginBottom="8dp" />

          <com.google.android.material.button.MaterialButtonToggleGroup
              android:id="@+id/scale_toggle"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              app:singleSelection="true"
              app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scale_100"
                style="?attr/materialButtonOutlinedStyle"
                android:text="100%"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scale_75"
                style="?attr/materialButtonOutlinedStyle"
                android:text="75%"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scale_50"
                style="?attr/materialButtonOutlinedStyle"
                android:text="50%"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
          </com.google.android.material.button.MaterialButtonToggleGroup>

          <com.google.android.material.textview.MaterialTextView
              style="@style/SettingLabel"
              android:text="@string/frame_rate"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="16dp"
              android:layout_marginBottom="8dp" />

          <com.google.android.material.button.MaterialButtonToggleGroup
              android:id="@+id/fps_toggle"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              app:singleSelection="true"
              app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fps_auto"
                style="?attr/materialButtonOutlinedStyle"
                android:text="@string/frame_rate_auto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fps_30"
                style="?attr/materialButtonOutlinedStyle"
                android:text="30"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fps_60"
                style="?attr/materialButtonOutlinedStyle"
                android:text="60"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
          </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Effects -->
      <com.google.android.material.card.MaterialCardView
          style="@style/Widget.Material3.CardView.Filled"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

          <com.google.android.material.textview.MaterialTextView
              style="@style/SectionTitle"
              android:text="@string/section_effects"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="4dp" />

          <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/switch_post_processing"
              android:text="@string/enable_post_processing"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:minHeight="48dp" />

          <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/switch_text"
              android:text="@string/enable_text_rendering"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:minHeight="48dp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Playback -->
      <com.google.android.material.card.MaterialCardView
          style="@style/Widget.Material3.CardView.Filled"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

          <com.google.android.material.textview.MaterialTextView
              style="@style/SectionTitle"
              android:text="@string/section_playback"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="4dp" />

          <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/switch_loop"
              android:text="@string/loop"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:minHeight="48dp" />

          <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/switch_random_seed"
              android:text="@string/random_seed"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:minHeight="48dp" />

          <com.google.android.material.textfield.TextInputLayout
              android:id="@+id/seed_layout"
              style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
              android:hint="@string/seed_hint"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/seed_input"
                android:inputType="number"
                android:maxLength="19"
                android:imeOptions="actionDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
          </com.google.android.material.textfield.TextInputLayout>

          <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/switch_stats"
              android:text="@string/show_stats"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:minHeight="48dp"
              android:layout_marginTop="4dp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Room for the play button -->
      <View
          android:layout_width="match_parent"
          android:layout_height="96dp" />
    </LinearLayout>
  </ScrollView>

  <!-- The play button stays on screen -->
  <LinearLayout
      android:id="@+id/bottom_bar"
      android:orientation="vertical"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom"
      android:background="@drawable/bg_bottom_bar"
      android:paddingLeft="16dp"
      android:paddingRight="16dp"
      android:paddingTop="12dp"
      android:paddingBottom="12dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/play_button"
        style="@style/Widget.Material3.Button.Icon"
        android:text="@string/play"
        app:icon="@drawable/ic_play"
        android:layout_width="match_parent"
        android:layout_height="56dp" />
  </LinearLayout>
</FrameLayout>
