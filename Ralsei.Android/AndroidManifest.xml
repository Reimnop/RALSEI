<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application android:allowBackup="true"
               android:icon="@mipmap/appicon"
               android:label="@string/app_name"
               android:roundIcon="@mipmap/appicon_round"
               android:resizeableActivity="true"
               android:enableOnBackInvokedCallback="true"
               android:appCategory="video"
               android:supportsRtl="true">
  </application>
  <uses-sdk android:targetSdkVersion="36" />

  <!-- Vulkan 1.3 is what the Vulkan renderer needs. Without it the app falls back to OpenGL ES, so it is not required -->
  <uses-feature android:name="android.hardware.vulkan.version" android:version="0x403000" android:required="false" />
  <uses-feature android:glEsVersion="0x00030000" android:required="true" />
</manifest>
