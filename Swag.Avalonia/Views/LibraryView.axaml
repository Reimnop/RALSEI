<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Swag.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
             x:Class="Swag.Avalonia.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
    <UserControl.Styles>
        <!-- A level in the list of recent levels -->
        <Style Selector="Button.LevelCard">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Frame"
                            Background="Transparent"
                            CornerRadius="{DynamicResource LgCornerRadius}"
                            Padding="8">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#Frame">
                <Setter Property="Background" Value="#14808080" />
            </Style>
        </Style>

        <!-- Its files are gone -->
        <Style Selector="Panel.RecentItem.Missing">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Taking a level off the list shows up when pointing at it -->
        <Style Selector="Panel.RecentItem Button.Forget">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Panel.RecentItem:pointerover Button.Forget">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource WindowBackgroundColor}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="940"
                        Margin="32,40,32,40"
                        Spacing="32"
                        HorizontalAlignment="Stretch">

                <StackPanel Spacing="6">
                    <TextBlock Text="SWAG"
                               Classes="h2" />
                    <TextBlock Text="Play .lsb and .vgd animations offline."
                               Classes="Muted"
                               FontSize="14" />
                </StackPanel>

                <!-- Open a level -->
                <Panel>
                    <Rectangle Stroke="{DynamicResource BorderColor}"
                               StrokeThickness="2"
                               StrokeDashArray="5,5"
                               RadiusX="14"
                               RadiusY="14" />
                    <StackPanel Margin="32,36"
                                Spacing="18"
                                HorizontalAlignment="Center">
                        <LucideIcon Kind="FolderOpen"
                                    Size="40"
                                    Opacity="0.7"
                                    HorizontalAlignment="Center" />
                        <StackPanel Spacing="4"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Drop a level here"
                                       Classes="h4"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="A level folder, or its beatmap (.vgd or .lsb) with its song."
                                       Classes="Muted"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    HorizontalAlignment="Center">
                            <Button Classes="Primary"
                                    Command="{Binding OpenFolderCommand}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <LucideIcon Kind="FolderOpen" Size="16" />
                                    <TextBlock Text="Open folder" />
                                </StackPanel>
                            </Button>
                            <Button Classes="Outline"
                                    Command="{Binding OpenFilesCommand}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <LucideIcon Kind="FileMusic" Size="16" />
                                    <TextBlock Text="Open files" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Panel>

                <!-- Levels that were opened before -->
                <StackPanel Spacing="12"
                            IsVisible="{Binding HasRecents}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Recent levels"
                                   Classes="h4"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="Ghost"
                                Command="{Binding ForgetAllCommand}"
                                Content="Clear" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Recents}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentLevelItem">
                                <Panel Classes="RecentItem"
                                       Classes.Missing="{Binding !IsAvailable}"
                                       Width="228"
                                       Margin="0,0,10,10">
                                    <Button Classes="LevelCard"
                                            Command="{Binding OpenCommand}">
                                        <StackPanel Spacing="8">
                                            <Border Height="116"
                                                    ClipToBounds="True"
                                                    CornerRadius="{DynamicResource MdCornerRadius}"
                                                    Background="#1F808080">
                                                <Panel>
                                                    <LucideIcon Kind="FileMusic"
                                                                Size="34"
                                                                Opacity="0.35"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                    <Image Source="{Binding Cover}"
                                                           Stretch="UniformToFill" />
                                                </Panel>
                                            </Border>
                                            <StackPanel Spacing="1"
                                                        Margin="2,0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}"
                                                           IsVisible="{Binding HasSubtitle}"
                                                           Classes="Muted"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding LastOpenedText}"
                                                           Classes="Muted"
                                                           FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="Icon Forget"
                                            Command="{Binding ForgetCommand}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="14"
                                            Width="28"
                                            Height="28"
                                            ToolTip.Tip="Take it off the list">
                                        <LucideIcon Kind="X" Size="14" />
                                    </Button>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
