<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:control="clr-namespace:Swag.Avalonia.Controls"
             xmlns:conv="clr-namespace:Swag.Avalonia.Converters"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:vm="clr-namespace:Swag.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="620"
             x:Class="Swag.Avalonia.Views.PlaybackView"
             x:DataType="vm:PlaybackViewModel">
    <Grid x:Name="Root"
          Background="Black"
          ClipToBounds="True"
          PointerMoved="Root_OnPointerMoved">

        <!-- The level -->
        <control:AspectRatioPanel IsLocked="{Binding Settings.LockAspectRatio}">
            <ContentControl Content="{Binding SwagViewModel}" />
        </control:AspectRatioPanel>

        <!-- Click: play or pause. Double click: full screen. -->
        <Border x:Name="InteractionLayer"
                Background="Transparent"
                IsVisible="{Binding IsReady}"
                PointerPressed="InteractionLayer_OnPointerPressed"
                PointerReleased="InteractionLayer_OnPointerReleased" />

        <!-- Everything on top of the level, which can be any color, is dark -->
        <ThemeVariantScope RequestedThemeVariant="Dark">
            <Grid>
            <!-- What just happened, over the middle -->
            <Border x:Name="PlayPauseIconContainer"
                    Width="168"
                    Height="168"
                    IsVisible="False"
                    Opacity="0"
                    IsHitTestVisible="False"
                    CornerRadius="{DynamicResource FullCornerRadius}"
                    Background="#99000000">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="0.5" ScaleY="0.5" />
                </Border.RenderTransform>

                <LucideIcon x:Name="PlayPauseIcon"
                            Size="84"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
            </Border>

            <!-- A message about a change (the volume, a seek) -->
            <Border Classes="Osd"
                    Classes.Shown="{Binding IsOsdVisible}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,76,0,0"
                    Padding="16,10"
                    CornerRadius="{DynamicResource FullCornerRadius}"
                    Background="#D90A0A0A"
                    BorderBrush="#26FFFFFF"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal"
                            Spacing="10">
                    <LucideIcon Kind="{Binding OsdIcon}"
                                Size="18"
                                VerticalAlignment="Center" />
                    <TextBlock Text="{Binding OsdText}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Performance stats -->
            <Border IsVisible="{Binding Settings.ShowStats}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="12,64,12,12"
                    Padding="12,8"
                    IsHitTestVisible="False"
                    CornerRadius="{DynamicResource MdCornerRadius}"
                    Background="#B30A0A0A">
                <StackPanel Spacing="2"
                            TextElement.FontFamily="{StaticResource JetbrainsFont}"
                            TextElement.FontSize="11">
                    <TextBlock Text="{Binding Fps, StringFormat='{}{0} FPS'}" FontWeight="Bold" />
                    <TextBlock Text="{Binding FrameTimeMs, StringFormat='{}{0:0.0} ms per frame'}" />
                    <TextBlock Text="{Binding RenderSizeText, StringFormat='Rendering at {0}'}" />
                </StackPanel>
            </Border>

            <!-- The title of the level -->
            <Panel Classes="AutoHide"
                   VerticalAlignment="Top"
                   IsVisible="{Binding IsReady}"
                   x:Name="TopBar">
                <Border Height="96"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#B3000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="10"
                      Margin="12,10,12,0"
                      Background="Transparent">
                    <Button Classes="PlaybackIcon"
                            Command="{Binding CloseLevelCommand}"
                            ToolTip.Tip="Back to the library">
                        <LucideIcon Kind="ArrowLeft" Size="18" />
                    </Button>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="0">
                        <TextBlock Text="{Binding Level.Title}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding LevelSubtitle}"
                                   IsVisible="{Binding HasSubtitle}"
                                   Classes="Muted"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Panel>

            <!-- The controls -->
            <Panel Classes="AutoHide"
                   VerticalAlignment="Bottom"
                   IsVisible="{Binding IsReady}"
                   x:Name="BottomBar">
                <Border Margin="0,0,0,0"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#D9000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel Margin="14,40,14,10"
                            Spacing="2"
                            Background="Transparent">
                    <control:TimelineScrubber x:Name="Scrubber"
                                              Minimum="0"
                                              Maximum="{Binding Duration}"
                                              Value="{Binding Position}"
                                              SeekRequested="Scrubber_OnSeekRequested" />

                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto"
                          ColumnSpacing="2">
                        <Button Grid.Column="0"
                                Classes="PlaybackIcon"
                                Command="{Binding PlayPauseDisplayIconCommand}"
                                ToolTip.Tip="Play / pause (Space)">
                            <LucideIcon Kind="{Binding PlayPauseIconKind}" Size="20" />
                        </Button>
                        <Button Grid.Column="1"
                                Classes="PlaybackIcon"
                                Command="{Binding SeekByCommand}"
                                ToolTip.Tip="Back 10 seconds (J)">
                            <Button.CommandParameter>
                                <x:Double>-10</x:Double>
                            </Button.CommandParameter>
                            <LucideIcon Kind="Rewind" Size="18" />
                        </Button>
                        <Button Grid.Column="2"
                                Classes="PlaybackIcon"
                                Command="{Binding SeekByCommand}"
                                ToolTip.Tip="Forward 10 seconds (L)">
                            <Button.CommandParameter>
                                <x:Double>10</x:Double>
                            </Button.CommandParameter>
                            <LucideIcon Kind="FastForward" Size="18" />
                        </Button>
                        <Button Grid.Column="3"
                                Classes="PlaybackIcon"
                                Margin="6,0,0,0"
                                Command="{Binding ToggleMuteCommand}"
                                ToolTip.Tip="Mute (M)">
                            <LucideIcon Kind="{Binding Settings.VolumeIconKind}" Size="18" />
                        </Button>
                        <Slider Grid.Column="4"
                                Width="96"
                                Minimum="0"
                                Maximum="1"
                                VerticalAlignment="Center"
                                Value="{Binding Settings.Volume}"
                                ToolTip.Tip="Volume" />
                        <TextBlock Grid.Column="5"
                                   Margin="14,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="12">
                            <Run Text="{Binding Position, Converter={x:Static conv:Converters.SecondsToText}}" />
                            <Run Text=" / "
                                 FontWeight="Bold" />
                            <Run Text="{Binding Duration, Converter={x:Static conv:Converters.SecondsToText}}" />
                        </TextBlock>

                        <Button Grid.Column="7"
                                Classes="PlaybackText"
                                Content="{Binding Settings.PlaybackSpeedText}"
                                ToolTip.Tip="Speed ([ and ])">
                            <Button.Flyout>
                                <MenuFlyout Placement="TopEdgeAlignedRight">
                                    <MenuItem Header="0.25×" Command="{Binding SetSpeedCommand}">
                                        <MenuItem.CommandParameter><x:Double>0.25</x:Double></MenuItem.CommandParameter>
                                    </MenuItem>
                                    <MenuItem Header="0.5×" Command="{Binding SetSpeedCommand}">
                                        <MenuItem.CommandParameter><x:Double>0.5</x:Double></MenuItem.CommandParameter>
                                    </MenuItem>
                                    <MenuItem Header="0.75×" Command="{Binding SetSpeedCommand}">
                                        <MenuItem.CommandParameter><x:Double>0.75</x:Double></MenuItem.CommandParameter>
                                    </MenuItem>
                                    <MenuItem Header="Normal" Command="{Binding SetSpeedCommand}">
                                        <MenuItem.CommandParameter><x:Double>1</x:Double></MenuItem.CommandParameter>
                                    </MenuItem>
                                    <MenuItem Header="1.25×" Command="{Binding SetSpeedCommand}">
                                        <MenuItem.CommandParameter><x:Double>1.25</x:Double></MenuItem.CommandParameter>
                                    </MenuItem>
                                    <MenuItem Header="1.5×" Command="{Binding SetSpeedCommand}">
                                        <MenuItem.CommandParameter><x:Double>1.5</x:Double></MenuItem.CommandParameter>
                                    </MenuItem>
                                    <MenuItem Header="2×" Command="{Binding SetSpeedCommand}">
                                        <MenuItem.CommandParameter><x:Double>2</x:Double></MenuItem.CommandParameter>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="8"
                                Classes="PlaybackIcon"
                                Classes.Active="{Binding Settings.Loop}"
                                Command="{Binding ToggleLoopCommand}"
                                ToolTip.Tip="Loop the song (Ctrl+L)">
                            <LucideIcon Kind="Repeat" Size="18" />
                        </Button>
                        <Button Grid.Column="9"
                                Classes="PlaybackIcon"
                                Command="{Binding RestartCommand}"
                                ToolTip.Tip="From the start (Home)">
                            <LucideIcon Kind="RotateCcw" Size="18" />
                        </Button>
                        <Button Grid.Column="10"
                                Classes="PlaybackIcon"
                                Command="{Binding ToggleFullScreenCommand}"
                                ToolTip.Tip="Full screen (F)">
                            <LucideIcon Kind="{Binding IsFullScreen, Converter={x:Static conv:Converters.FullScreenIcon}}" Size="18" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Panel>

            <!-- Reading a level -->
            <Grid IsVisible="{Binding IsLoading}"
                  Background="#F20A0A0A">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="14">
                    <shadui:Loading Width="36"
                                    Height="36"
                                    HorizontalAlignment="Center" />
                    <TextBlock Text="Opening level"
                               Classes="h4"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding LoadingText}"
                               Classes="Muted"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
            </Grid>
        </ThemeVariantScope>

        <!-- No level: open one -->
        <ContentControl Content="{Binding Library}"
                        IsVisible="{Binding IsEmpty}" />
    </Grid>
</UserControl>
